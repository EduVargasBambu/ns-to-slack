<customrecordtype scriptid="customrecord_gpv_audit_log">
  <accesstype>CUSTRECORDENTRYPERM</accesstype>
  <allowattachments>F</allowattachments>
  <allowinlinedeleting>F</allowinlinedeleting>
  <allowinlineediting>F</allowinlineediting>
  <allowquicksearch>T</allowquicksearch>
  <allowuiaccess>T</allowuiaccess>
  <description>Evidencia de cada acción de autorización: quién, qué, sobre qué línea, en qué nivel, desde qué canal y cuándo (fecha de creación). Incluye intentos no autorizados y limpiezas de aprobaciones previas. No se edita ni se borra.</description>
  <enabledle>T</enabledle>
  <enablekeywords>F</enablekeywords>
  <enablemailmerge>F</enablemailmerge>
  <enablenumbering>F</enablenumbering>
  <enableoptimisticlocking>T</enableoptimisticlocking>
  <enablesystemnotes>T</enablesystemnotes>
  <hierarchical>F</hierarchical>
  <includename>F</includename>
  <isinactive>F</isinactive>
  <isordered>F</isordered>
  <recordname>GPV - Bitácora de autorización</recordname>
  <showcreationdate>T</showcreationdate>
  <showcreationdateonlist>T</showcreationdateonlist>
  <showid>T</showid>
  <showlastmodified>T</showlastmodified>
  <showlastmodifiedonlist>F</showlastmodifiedonlist>
  <shownotes>T</shownotes>
  <showowner>T</showowner>
  <customrecordcustomfields>
    <customrecordcustomfield scriptid="custrecord_gpv_al_proposal">
      <accesslevel>2</accesslevel>
      <description>Concentrado de la línea.</description>
      <displaytype>NORMAL</displaytype>
      <fieldtype>SELECT</fieldtype>
      <help>Concentrado al que pertenece la factura. Puede quedar vacío en un intento no autorizado que no se pudo asociar.</help>
      <isparent>F</isparent>
      <ismandatory>F</ismandatory>
      <label>Concentrado</label>
      <searchlevel>2</searchlevel>
      <selectrecordtype>[scriptid=customrecord_gpv_payment_proposal]</selectrecordtype>
      <showinlist>T</showinlist>
      <storevalue>T</storevalue>
    </customrecordcustomfield>
    <customrecordcustomfield scriptid="custrecord_gpv_al_line">
      <accesslevel>2</accesslevel>
      <description>Línea del concentrado sobre la que se actuó.</description>
      <displaytype>NORMAL</displaytype>
      <fieldtype>SELECT</fieldtype>
      <help>Línea del concentrado (factura) sobre la que se actuó. Puede quedar vacía en un intento no autorizado que no se pudo asociar.</help>
      <isparent>F</isparent>
      <ismandatory>F</ismandatory>
      <label>Línea</label>
      <searchlevel>2</searchlevel>
      <selectrecordtype>[scriptid=customrecord_gpv_proposal_line]</selectrecordtype>
      <showinlist>T</showinlist>
      <storevalue>T</storevalue>
    </customrecordcustomfield>
    <customrecordcustomfield scriptid="custrecord_gpv_al_level">
      <accesslevel>2</accesslevel>
      <description>Nivel en que estaba la línea al actuar.</description>
      <displaytype>NORMAL</displaytype>
      <fieldtype>SELECT</fieldtype>
      <help>Nivel en que estaba la factura al actuar. En una limpieza de aprobaciones previas, es el nivel cuyo campo legado se limpió.</help>
      <isparent>F</isparent>
      <ismandatory>F</ismandatory>
      <label>Nivel</label>
      <searchlevel>2</searchlevel>
      <selectrecordtype>[scriptid=customrecord_gpv_approval_level]</selectrecordtype>
      <showinlist>T</showinlist>
      <storevalue>T</storevalue>
    </customrecordcustomfield>
    <customrecordcustomfield scriptid="custrecord_gpv_al_action">
      <accesslevel>2</accesslevel>
      <description>Acción realizada.</description>
      <displaytype>NORMAL</displaytype>
      <fieldtype>SELECT</fieldtype>
      <help>Aprobar, Descartar, Intento no autorizado o Limpieza de aprobaciones previas.</help>
      <isparent>F</isparent>
      <ismandatory>T</ismandatory>
      <label>Acción</label>
      <searchlevel>2</searchlevel>
      <selectrecordtype>[scriptid=customlist_gpv_action]</selectrecordtype>
      <showinlist>T</showinlist>
      <storevalue>T</storevalue>
    </customrecordcustomfield>
    <customrecordcustomfield scriptid="custrecord_gpv_al_employee">
      <accesslevel>2</accesslevel>
      <description>Empleado que hizo la acción.</description>
      <displaytype>NORMAL</displaytype>
      <fieldtype>SELECT</fieldtype>
      <help>Empleado de NetSuite que hizo la acción. Vacío si un usuario de Slack sin empleado asociado intentó actuar.</help>
      <isparent>F</isparent>
      <ismandatory>F</ismandatory>
      <label>Empleado</label>
      <searchlevel>2</searchlevel>
      <selectrecordtype>-4</selectrecordtype>
      <showinlist>T</showinlist>
      <storevalue>T</storevalue>
    </customrecordcustomfield>
    <customrecordcustomfield scriptid="custrecord_gpv_al_channel">
      <accesslevel>2</accesslevel>
      <description>Canal desde el que se actuó.</description>
      <displaytype>NORMAL</displaytype>
      <fieldtype>SELECT</fieldtype>
      <help>Slack o NetSuite.</help>
      <isparent>F</isparent>
      <ismandatory>T</ismandatory>
      <label>Canal</label>
      <searchlevel>2</searchlevel>
      <selectrecordtype>[scriptid=customlist_gpv_channel]</selectrecordtype>
      <showinlist>T</showinlist>
      <storevalue>T</storevalue>
    </customrecordcustomfield>
    <customrecordcustomfield scriptid="custrecord_gpv_al_slack_user">
      <accesslevel>2</accesslevel>
      <description>ID del usuario de Slack, si la acción vino de Slack.</description>
      <displaytype>NORMAL</displaytype>
      <fieldtype>TEXT</fieldtype>
      <help>ID del usuario de Slack (por ejemplo U0123456789) que hizo la acción. Vacío si se hizo desde NetSuite.</help>
      <isparent>F</isparent>
      <ismandatory>F</ismandatory>
      <label>Usuario de Slack</label>
      <maxlength>20</maxlength>
      <searchlevel>2</searchlevel>
      <showinlist>T</showinlist>
      <storevalue>T</storevalue>
    </customrecordcustomfield>
    <customrecordcustomfield scriptid="custrecord_gpv_al_reason">
      <accesslevel>2</accesslevel>
      <description>Motivo capturado al descartar.</description>
      <displaytype>NORMAL</displaytype>
      <fieldtype>TEXTAREA</fieldtype>
      <help>Motivo que escribió el aprobador al descartar la factura.</help>
      <isparent>F</isparent>
      <ismandatory>F</ismandatory>
      <label>Motivo</label>
      <searchlevel>2</searchlevel>
      <showinlist>T</showinlist>
      <storevalue>T</storevalue>
    </customrecordcustomfield>
    <customrecordcustomfield scriptid="custrecord_gpv_al_idempotency_key">
      <accesslevel>2</accesslevel>
      <description>Clave única línea + nivel + acción.</description>
      <displaytype>NORMAL</displaytype>
      <fieldtype>TEXT</fieldtype>
      <help>Clave línea + nivel + acción que evita registrar dos veces la misma aprobación o descarte (reintentos de Slack o doble clic). Vacía en las demás acciones.</help>
      <isparent>F</isparent>
      <ismandatory>F</ismandatory>
      <label>Clave de idempotencia</label>
      <maxlength>100</maxlength>
      <searchlevel>2</searchlevel>
      <showinlist>T</showinlist>
      <storevalue>T</storevalue>
    </customrecordcustomfield>
  </customrecordcustomfields>
</customrecordtype>
